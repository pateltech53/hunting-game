; Engine configuration file.
; Wildlight - a voxel photography and hunting game.

config_version=5

[application]

config/name="Wildlight"
config/description="A voxel photography and hunting game. Track wildlife, photograph it, and fill your Discovery Book."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.035, 0.043, 0.051, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/autoload/settings_manager.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
Codex="*res://scripts/autoload/codex.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"
Bank="*res://scripts/economy/economy.gd"
Game="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="terrain"
3d_physics/layer_2="player"
3d_physics/layer_3="wildlife"
3d_physics/layer_4="props"
3d_physics/layer_5="villagers"

[physics]

3d/default_gravity=22.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
; The web export runs on WebGL2, which only the Compatibility renderer targets.
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=1
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=1
